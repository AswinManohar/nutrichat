# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.

# Mealsy backend (FastAPI). Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Supabase project credentials (Project Settings -> API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public origin this frontend is served from. Used to build the `emailRedirectTo`
# target for Supabase auth emails, so verification links point at this app's
# /auth/callback route instead of the Supabase project's Site URL (which is
# localhost by default). Falls back to window.location.origin when unset, so it
# only needs setting for deployed environments.
# Production: https://nutrichat-frontend.netlify.app
# Whatever you set here must also be in Supabase -> Authentication -> URL
# Configuration -> Redirect URLs (e.g. https://nutrichat-frontend.netlify.app/**).
VITE_APP_URL=http://localhost:5173
