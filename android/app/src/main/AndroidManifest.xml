<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Requested at runtime on first entry to ChatScreen (API 33+); required
         to show FCM notifications there (see MealsyMessagingService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".MealsyApp"
        android:allowBackup="false"
        android:label="Mealsy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- WorkManager's default initializer builds a Configuration with a
             plain WorkerFactory, which cannot construct @HiltWorker workers
             (see ReplayWorker). Remove it so MealsyApp's own
             Configuration.Provider (backed by HiltWorkerFactory) is used
             instead, per the WorkManager+Hilt integration guide. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase PKCE magic-link / OAuth callback (Task 4). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mealsy" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- FCM registration + notification handling (Task 9). Works
             unconditionally in the manifest: on a checkout without
             google-services.json there's no Firebase app for the FCM SDK to
             route messages through, so this service is simply never
             started. -->
        <service
            android:name=".push.MealsyMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
