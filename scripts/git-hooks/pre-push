#!/usr/bin/env bash
#
# pre-push — block pushes to `production` that haven't passed
# scripts/prod-checks.sh. Ship with scripts/push-to-production.sh (or /ship in
# Claude Code); it runs the checks and records the pass this hook looks for.
#
# Emergency bypass (e.g. an urgent rollback): git push --no-verify ...
# Install: scripts/install-git-hooks.sh
#
set -euo pipefail
MARKER_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)/prod-checks"
ZERO="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$remote_ref" == "refs/heads/production" ]] || continue
  [[ "$local_sha" == "$ZERO" ]] && { echo "pre-push: refusing to delete production." >&2; status=1; continue; }
  marker="$MARKER_DIR/$local_sha"
  if [[ ! -f "$marker" || -z "$(find "$marker" -mmin -1440)" ]]; then
    echo "pre-push: ${local_sha:0:8} has no passing production checks from the last 24 h." >&2
    echo "          Run: scripts/push-to-production.sh ${local_sha:0:8}" >&2
    status=1
  fi
done
exit $status
