GOOGLE_API_KEY=          # Gemini Flash-Lite + text-embedding-005
ANTHROPIC_API_KEY=       # Fallback / Pro tier
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nutrichat
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=     # Supabase dashboard -> Settings -> API -> JWT Secret (HS256)
USDA_API_KEY=            # fdc.nal.usda.gov/api-key-signup/
LANGSMITH_TRACING=true   # enable LangSmith run tracing (needs API key)
LANGSMITH_API_KEY=       # smith.langchain.com -> Settings -> API Keys
LANGSMITH_PROJECT=nutrichat
LOGFIRE_TOKEN=           # logfire.pydantic.dev -> project -> Write tokens
LOGFIRE_ENVIRONMENT=dev  # logfire.pydantic.dev -> project -> Write tokens
LOGFIRE_ENABLED=true     # set false in production to disable Logfire entirely

# Dev only: when "true", requests may set X-Debug-User-Id instead of a
# Supabase bearer token. NEVER enable in production.
DEV_BYPASS_AUTH=false

# Telegram bot (M7) — create via @BotFather
TELEGRAM_BOT_TOKEN=      # BotFather -> /newbot
TELEGRAM_BOT_USERNAME=   # without the @, shown in Settings link instructions
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_SECRET= # prod only, sent as X-Telegram-Bot-Api-Secret-Token

# Web Push (onboarding reminders). Generate a VAPID keypair, e.g.
#   python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); \
#     print(v.public_key, v.private_key)"
# When VAPID_PUBLIC_KEY is unset, GET /push/vapid-public-key returns 404 and the
# frontend gracefully hides the reminder feature. Sender is a separate task.
VAPID_PUBLIC_KEY=        # base64url-encoded public key, exposed to the browser
VAPID_PRIVATE_KEY=       # base64url-encoded private key, server-only
VAPID_SUBJECT=mailto:admin@nutrichat.app  # contact URI required by Web Push
